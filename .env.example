# ==============================================================================
# Chalksy — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to GitHub.
# ==============================================================================

# --- App Server ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# --- Qdrant Cloud Vector Memory ---
# Leave blank to use embedded local storage (./data/qdrant_storage). No sign-up needed.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./data/qdrant_storage

# --- Lyzr Multi-Agent Studio ---
# Get free key from: https://studio.lyzr.ai/
LYZR_API_KEY=
LYZR_AGENT_ID=

# --- OpenRouter (100% Free LLMs) ---
# Free key from: https://openrouter.ai/keys
# Free models: meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Google AI Studio (Optional free Gemini) ---
# Free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# --- Other Providers (all optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Omi Audio Wearable ---
OMI_WEBHOOK_SECRET=omi_hackathon_secret_2026
OMI_APP_ID=
OMI_APP_SECRET=

# --- Local Storage ---
LOCAL_ENCRYPTION_KEY=super_secure_32_byte_aes_secret_key_hackathon!
STUDENT_MAPPING_DB=./data/student_registry.db
TASK_STATE_DB=./data/tasks.db
